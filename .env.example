# Gemini API (server-side)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Azure Speech Services (server-side)
# Get these from your Azure Speech resource.
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=eastus

# MongoDB connection for interview sessions
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=smartcv

# JSearch API (client-side)
# Get your key from: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
VITE_JSEARCH_API_KEY=your_jsearch_api_key_here
